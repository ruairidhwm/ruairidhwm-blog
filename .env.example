# Production canonical URL (include https, no trailing slash)
# NEXT_PUBLIC_SITE_URL=https://example.com

# Optional branding
# NEXT_PUBLIC_SITE_NAME=My Blog
# NEXT_PUBLIC_SITE_DESCRIPTION=A short site tagline.
# NEXT_PUBLIC_AUTHOR_NAME=Your Name

# Optional footer links
# NEXT_PUBLIC_GITHUB_URL=https://github.com/you/your-repo
# NEXT_PUBLIC_LINKEDIN_URL=https://www.linkedin.com/in/your-profile

# Buttondown newsletter (footer subscribe form). Username = your newsletter slug from buttondown.com/username
# NEXT_PUBLIC_BUTTONDOWN_USERNAME=yourname
# Optional: tag new subscribers from this form (see Buttondown docs → tags)
# NEXT_PUBLIC_BUTTONDOWN_TAG=blog
